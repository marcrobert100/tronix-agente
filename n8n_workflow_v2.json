    {
      "id": "http-request",
      "name": "Gerar Imagem Cloudflare",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/accounts/038280d984d9c936772700b7dbbc479e/ai/run/@cf/stabilityai/stable-diffusion-xl-base-1.0",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer cfut_nI8gZqUUHil8sG6xjjE1W26wbVHgDyU8PRQTdUV2e61edb64"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "prompt", "value": "={{ $json.prompt || $json.payload.prompt || 'Cinematic shot of a Brazilian landscape, hyper-realistic, epic atmosphere, 4k' }}"}
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code-convert",
      "name": "Salvar Imagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300],
      "parameters": {
        "language": "python",
        "code": "import os\nimport base64\nfrom datetime import datetime\n\nresponse = items[0].json\n\nif 'result' in response:\n    img_data = response['result']\n    if isinstance(img_data, dict) and 'image' in img_data:\n        img_data = img_data['image']\n    \n    if isinstance(img_data, str):\n        img_bytes = base64.b64decode(img_data)\n    else:\n        img_bytes = bytes(img_data)\n    \n    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')\n    filename = f'uploads/tronix_{timestamp}.png'\n    \n    with open(filename, 'wb') as f:\n        f.write(img_bytes)\n    \n    items[0]['json']['arquivo'] = filename\n    items[0]['json']['timestamp'] = timestamp\n    items[0]['json']['prompt_usado'] = items[0].json.get('prompt', '') or items[0].json.get('payload', {}).get('prompt', '')\n\nreturn items"
      }
    },
    {
      "id": "exec-script",
      "name": "Criar Video Ken Burns",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 300],
      "parameters": {
        "command": "python",
        "arguments": {
          "parameters": [
            {"name": "script", "value": "={{ 'gera_video.py --pasta ' + $json['arquivo'] + ' --saida videos_saida/' + $json['timestamp'] + '.mp4 --duracao 6 --animacao fade' }}"}
          ]
        }
      }
    },
    {
      "id": "exec-super",
      "name": "Adicionar Voz Edge-TTS",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1250, 300],
      "parameters": {
        "command": "python",
        "arguments": {
          "parameters": [
            {"name": "script", "value": "={{ 'tronix_super_editor.py videos_saida/' + $json['timestamp'] + '.mp4' }}"}
          ]
        }
      }
    },
    {
      "id": "webhook-resp",
      "name": "Resposta pro Gateway",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [1600, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
